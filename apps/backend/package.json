  "license": "MIT",
  "scripts": {
    "postbuild": "mkdir -p .medusa/server/src/jobs .medusa/server/src/subscribers .medusa/server/src/workflows .medusa/server/src/modules && cp -R src/jobs/. .medusa/server/src/jobs/ && cp -R src/subscribers/. .medusa/server/src/subscribers/ && cp -R src/workflows/. .medusa/server/src/workflows/ && cp -R src/modules/. .medusa/server/src/modules/",
    "build": "medusa build && npm run postbuild && cp -f medusa-config.js .medusa/server/medusa-config.js",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "medusa lint"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.21.1",
    "@medusajs/admin-shared": "2.21.1",
    "@medusajs/cache-inmemory": "2.21.1",
    "@medusajs/cli": "2.21.1",
    "@medusajs/dashboard": "2.21.1",
    "@medusajs/draft-order": "2.21.1",
    "@medusajs/framework": "2.21.1",
    "@medusajs/medusa": "2.21.1",
    "@medusajs/ui": "4.2.4",
    "@tanstack/react-query": "5.64.2",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "zod": "4.2.0",
    "openai": "7.23.0",
    "medusa-payment-pesapal": "0.0.13",
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.21.1",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "vite": "^7.3.6",
    "yalc": "^1.0.0-pre.50"
  },
  "engines": {
    "node": "20.x"
  }
}
